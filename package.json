{
  "name": "buzzcloud-index",
  "version": "0.1.0",
  "description": "BuzzCloud Index: a fast, private web browser built on Chromium",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "icon": "electron build/render-icon.js",
    "release": "electron-builder --publish always"
  },
  "author": {
    "name": "BuzzCloud"
  },
  "license": "MIT",
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.1",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "productName": "BuzzCloud Index",
  "build": {
    "appId": "com.buzzcloud.index",
    "productName": "BuzzCloud Index",
    "files": [
      "src/**/*",
      "brand.json",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "protocols": [
      {
        "name": "Web",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network;WebBrowser",
      "mimeTypes": [
        "x-scheme-handler/http",
        "x-scheme-handler/https",
        "text/html"
      ],
      "executableName": "buzzcloud-index",
      "icon": "build/icon.png",
      "maintainer": "BuzzCloud",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "buzzyboy42",
        "repo": "buzzcloud-index",
        "releaseType": "draft"
      }
    ],
    "artifactName": "BuzzCloud-Index-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "artifactName": "BuzzCloud-Index-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BuzzCloud Index"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/buzzyboy42/buzzcloud-index.git"
  },
  "desktopName": "buzzcloud-index.desktop"
}
